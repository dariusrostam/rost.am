---
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../config';
import marginNotesCss from '../styles/margin-notes.css?raw';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  language: 'en' | 'de';
  venue?: string;
  venueUrl?: string;
  crosspostMode?: 'full' | 'stub';
  canonical?: string;
  demo?: boolean;
}

const {
  title,
  description,
  date,
  updated,
  tags = [],
  language,
  venue,
  venueUrl,
  crosspostMode,
  canonical,
  demo = false,
} = Astro.props;

const isCrosspost = Boolean(venue);
const outwardCanonical = isCrosspost && crosspostMode === 'full' ? canonical : undefined;

const dateFormatter = new Intl.DateTimeFormat(language === 'de' ? 'de-DE' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  ...(updated && { dateModified: updated.toISOString() }),
  inLanguage: language,
  author: { '@type': 'Person', name: SITE.author },
  ...(isCrosspost && venueUrl && crosspostMode === 'stub' && { url: venueUrl }),
};
---

<BaseLayout
  title={title}
  description={description}
  lang={language}
  type="article"
  canonical={outwardCanonical}
  jsonLd={jsonLd}
  noindex={demo}
>
  <Fragment slot="head">
    <style set:html={marginNotesCss}></style>
  </Fragment>

  <article class="page prose-width" style="padding-block: var(--space-6) var(--space-8);">
    {demo && (
      <p class="meta" style="margin-bottom: var(--space-4);">
        <strong>Demo post</strong> — exists only to exercise the margin-note system, not part of the real site content.
      </p>
    )}

    {isCrosspost && crosspostMode === 'full' && venueUrl && (
      <p class="meta" data-no-print style="margin-bottom: var(--space-4);">
        This appeared first in <a href={venueUrl} target="_blank" rel="noopener noreferrer">{venue}</a>.
      </p>
    )}

    <header style="margin-bottom: var(--space-6);">
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{dateFormatter.format(date)}</time>
        {updated && (
          <>
            {' · '}updated <time datetime={updated.toISOString()}>{dateFormatter.format(updated)}</time>
          </>
        )}
        {' · '}
        <span class="badge">{language === 'de' ? 'DE' : 'EN'}</span>
        {tags.map((tag) => <span class="badge" style="margin-left: 0.3em;">{tag}</span>)}
      </p>
    </header>

    {isCrosspost && crosspostMode === 'stub' ? (
      <>
        <p>{description}</p>
        {venueUrl && (
          <p>
            <a class="button" href={venueUrl} target="_blank" rel="noopener noreferrer">
              Read at {venue} →
            </a>
          </p>
        )}
      </>
    ) : (
      <div class="article-body">
        <slot />
      </div>
      <script>
        import '../scripts/margin-notes.js';
      </script>
    )}
  </article>
</BaseLayout>

---
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../config';
import '../styles/margin-notes.css';

interface Props {
  title: string;
  description: string;
  slug: string;
  date: Date;
  updated?: Date;
  language: 'en' | 'de';
  venue?: string;
  venueUrl?: string;
  crosspostMode?: 'full' | 'stub';
  canonical?: string;
  link?: string;
  linkSource?: string;
  thumbnail?: string;
  demo?: boolean;
}

const {
  title,
  description,
  slug,
  date,
  updated,
  language,
  venue,
  venueUrl,
  crosspostMode,
  canonical,
  link,
  thumbnail,
  demo = false,
} = Astro.props;

const isCrosspost = Boolean(venue);
const outwardCanonical = isCrosspost && crosspostMode === 'full' ? canonical : undefined;

const dateFormatter = new Intl.DateTimeFormat(language === 'de' ? 'de-DE' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  ...(updated && { dateModified: updated.toISOString() }),
  inLanguage: language,
  author: { '@type': 'Person', name: SITE.author },
  ...(isCrosspost && venueUrl && crosspostMode === 'stub' && { url: venueUrl }),
};
---

<BaseLayout
  title={title}
  description={description}
  lang={language}
  type="article"
  canonical={outwardCanonical}
  jsonLd={jsonLd}
  noindex={demo}
  image={new URL(`/og/blog/${slug}.png`, SITE.url).toString()}
>
  <article class="page" data-accent="teal" style="padding-block: var(--space-6) var(--space-8);">
    <div class="prose-width">
      {demo && (
        <p class="meta" style="margin-bottom: var(--space-4);">
          <strong>Demo post</strong> — exists only to exercise the margin-note system, not part of the real site content.
        </p>
      )}

      {isCrosspost && crosspostMode === 'full' && venueUrl && (
        <p class="meta" data-no-print style="margin-bottom: var(--space-4);">
          This appeared first in <a href={venueUrl} target="_blank" rel="noopener noreferrer">{venue}</a>.
        </p>
      )}

      <img
        class="detail-thumb"
        src={thumbnail ?? '/images/darius-rostam.jpg'}
        width="595"
        height="842"
        loading="eager"
        decoding="async"
        alt=""
      />

      <header style="margin-bottom: var(--space-6);">
        <h1>
          {link ? (
            <a href={link} target="_blank" rel="noopener noreferrer">
              {title} <span aria-hidden="true">↗</span>
            </a>
          ) : (
            title
          )}
        </h1>
        <p class="meta" style="margin-top: var(--space-2);">
          <time datetime={date.toISOString()}>{dateFormatter.format(date)}</time>
          {updated && (
            <>
              {' · '}updated <time datetime={updated.toISOString()}>{dateFormatter.format(updated)}</time>
            </>
          )}
        </p>
      </header>

      {isCrosspost && crosspostMode === 'stub' && (
        <>
          <p>{description}</p>
          {venueUrl && (
            <p>
              <a class="button" href={venueUrl} target="_blank" rel="noopener noreferrer">
                Read at {venue} →
              </a>
            </p>
          )}
        </>
      )}
    </div>

    {!(isCrosspost && crosspostMode === 'stub') && (
      <>
        <div class="article-body">
          <slot />
        </div>
        <script>
          import '../scripts/margin-notes.js';
        </script>
      </>
    )}
  </article>
</BaseLayout>

---
import notFoundCss from '../styles/not-found.css?raw';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found — Darius Rostam</title>
    <meta name="robots" content="noindex" />
    <style set:html={notFoundCss}></style>
  </head>
  <body>
    <main>
      <div class="card-wrap">
        <img class="luna" src="/images/luna-404.png" width="345" height="420" alt="Luna, a golden retriever puppy, peering over the top of this card" />
        <div class="card">
          <h1>404</h1>
          <p class="line">Luna couldn't find this page either.</p>
          <p class="links">
            <a href="/">Home</a>
            <span>·</span>
            <a href="/research">Research</a>
            <span>·</span>
            <a href="/blog">Blog</a>
            <span>·</span>
            <a href="/about">About</a>
          </p>
        </div>
      </div>
    </main>
  </body>
</html>

---
// The only playful thing on the site (brief: "the whole joke and it should
// be the only one") -- a CJEU judgment styled 404 page. Deliberately does
// NOT use BaseLayout: no header/footer/theme-toggle chrome, no scripts at
// all (brief: "zero JavaScript"), and no dark mode -- a real judgment
// doesn't have one, and committing to that is part of playing it straight.
// GitHub Pages serves this file automatically (as dist/404.html) with an
// actual 404 status for any unmatched path; see README for the deploy note.

const today = new Date();
const dateFormatter = new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
const longDate = dateFormatter.format(today); // e.g. "23 August 2026"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found — Darius Rostam</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      @font-face {
        font-family: 'Source Serif 4 Variable';
        font-style: normal;
        font-weight: 200 900;
        font-display: swap;
        src: url('/fonts/source-serif-4-latin-wght-normal.woff2') format('woff2-variations');
      }
      @font-face {
        font-family: 'Source Serif 4 Variable';
        font-style: italic;
        font-weight: 200 900;
        font-display: swap;
        src: url('/fonts/source-serif-4-latin-wght-italic.woff2') format('woff2-variations');
      }

      * {
        box-sizing: border-box;
      }

      html {
        color-scheme: light;
      }

      body {
        margin: 0;
        padding: 3rem 1.25rem 5rem;
        background: #f4f2ec;
        color: #111;
        font-family: 'Source Serif 4 Variable', Georgia, 'Times New Roman', serif;
        font-variation-settings: 'wght' 400;
        font-size: 0.95rem;
        line-height: 1.6;
      }

      main {
        max-width: 40em;
        margin: 0 auto;
        background: #fff;
        padding: 3rem 3.5rem 4rem;
        border: 1px solid #ccc;
      }

      p,
      li {
        text-align: justify;
        hyphens: auto;
      }

      h1 {
        font-size: 1.05rem;
        font-weight: 400;
        font-variation-settings: 'wght' 600;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        margin: 0 0 0.5rem;
      }

      .date-line {
        text-align: center;
        margin: 0 0 1.5rem;
      }

      .keywords {
        font-style: italic;
        text-align: center;
        max-width: 32em;
        margin: 0 auto 2rem;
        font-size: 0.9rem;
      }

      .case-number {
        margin: 2rem 0 1rem;
      }

      .reference-formula {
        margin: 1rem 0 2rem;
      }

      .parties {
        text-align: center;
        margin: 2rem 0;
      }

      .parties .v {
        font-style: italic;
        margin: 0 0.5em;
      }

      .bench {
        margin: 2rem 0;
      }

      .recitals p {
        text-align: left;
        margin: 0.4rem 0;
      }

      .judgment-intro {
        text-align: center;
        margin: 2rem 0;
      }

      h2 {
        font-size: 0.95rem;
        font-weight: 400;
        font-variation-settings: 'wght' 600;
        text-align: center;
        margin: 2.5rem 0 1.5rem;
      }

      ol.paragraphs {
        list-style: none;
        counter-reset: none;
        padding: 0;
        margin: 0;

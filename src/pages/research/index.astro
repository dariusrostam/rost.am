---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterBar from '../../components/FilterBar.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import { TYPE_LABEL } from '../../lib/citations';
import { AREA_LABELS, AREA_ORDER } from '../../lib/taxonomy';

const pubs = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);

const QUICK_AREAS = ['copyright', 'ai', 'it-security-law', 'law-and-society'] as const;

const areaFacet = {
  key: 'area',
  label: 'Area',
  options: AREA_ORDER.filter((a) => pubs.some((p) => p.data.areas.includes(a as never))).map((value) => ({
    value,
    label: AREA_LABELS[value],
    count: pubs.filter((p) => p.data.areas.includes(value as never)).length,
  })),
};
const typeFacet = {
  key: 'type',
  label: 'Type',
  options: (Object.keys(TYPE_LABEL) as (keyof typeof TYPE_LABEL)[])
    .filter((t) => pubs.some((p) => p.data.type === t))
    .map((value) => ({
      value,
      label: TYPE_LABEL[value],
      count: pubs.filter((p) => p.data.type === value).length,
    })),
};
---

<BaseLayout title="Research" description="Publications on copyright, AI and law and technology — monographs, articles, chapters and working papers.">
  <div class="page" data-accent="violet" style="padding-block: var(--space-6) var(--space-8);">
    <h1>Research</h1>
    <hr class="accent-rule" />

    <div class="research-filter-box">
      <div class="research-quick-filters" role="group" aria-label="Quick filter by area">
        {
          QUICK_AREAS.map((value) => (
            <button type="button" class="chip" data-facet="area" data-value={value} aria-pressed="false">
              {AREA_LABELS[value]}
            </button>
          ))
        }
        <button type="button" class="chip" data-more-toggle aria-expanded="false" aria-controls="research-more-panel">
          More
        </button>
      </div>
      <div class="research-more-panel" data-more-panel id="research-more-panel" hidden>
        <FilterBar facets={[areaFacet, typeFacet]} searchPlaceholder="Search title, venue, co-authors" />
      </div>
    </div>

    <div data-filter-list class="research-entries">
      <ul class="card-list card-list--divided">
        {pubs.map((pub) => <PublicationCard pub={{ ...pub.data, slug: pub.id }} />)}
      </ul>
    </div>
  </div>

  <script>
    import '../../scripts/research-more.js';
  </script>
</BaseLayout>

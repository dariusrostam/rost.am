---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TYPE_LABEL, coAuthorLine } from '../../lib/citations';
import { chipStyle } from '../../lib/chipColors';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const pubs = await getCollection('publications');
  return pubs.map((pub) => ({ params: { slug: pub.id }, props: { pub: pub.data } }));
}

const { pub } = Astro.props;
const pageURL = new URL(Astro.url.pathname, SITE.url).toString();
const pdfURL = pub.pdf ? new URL(pub.pdf, SITE.url).toString() : undefined;

const isArticleLike = pub.type === 'article' || pub.type === 'case-note';
const journalMatch = isArticleLike ? pub.venue.match(/^([A-Za-zÄÖÜäöüß.]+)/) : null;
const firstPageMatch = isArticleLike ? pub.venue.match(/,\s*(\d+)/) : null;

const coauthors = coAuthorLine(pub);

const jsonLdType = pub.type === 'monograph' || pub.type === 'edited-volume' ? 'Book' : pub.type === 'chapter' ? 'Chapter' : 'ScholarlyArticle';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': jsonLdType,
  name: pub.title,
  author: pub.authors.map((name: string) => ({ '@type': 'Person', name })),
  datePublished: String(pub.year),
  inLanguage: pub.language,
  ...(pub.doi && { sameAs: `https://doi.org/${pub.doi}` }),
  ...(pdfURL && { url: pdfURL }),
  isPartOf: pub.venue,
  ...(pub.abstract && { abstract: pub.abstract }),
};
---

<BaseLayout
  title={pub.title}
  description={pub.abstract ?? `${TYPE_LABEL[pub.type]} — ${pub.venue}`}
  lang={pub.language}
  type="article"
  jsonLd={jsonLd}
  image={new URL(`/og/research/${pub.slug}.png`, SITE.url).toString()}
>
  <Fragment slot="head">
    <meta name="citation_title" content={pub.title} />
    {pub.authors.map((name: string) => (
      <meta name="citation_author" content={name} />
    ))}
    <meta name="citation_publication_date" content={String(pub.year)} />
    {isArticleLike && journalMatch && <meta name="citation_journal_title" content={journalMatch[1]} />}
    {pub.type === 'chapter' && <meta name="citation_inbook_title" content={pub.venue} />}
    {firstPageMatch && <meta name="citation_firstpage" content={firstPageMatch[1]} />}
    {pub.doi && <meta name="citation_doi" content={pub.doi} />}
    {pdfURL && <meta name="citation_pdf_url" content={pdfURL} />}
    <meta name="citation_language" content={pub.language} />
    <meta name="citation_abstract_html_url" content={pageURL} />
  </Fragment>

  <article class="page" data-accent="violet" style="padding-block: var(--space-6) 0;">
    <div class="prose-width">
      <img
        class="detail-thumb"
        src={pub.thumbnail ?? '/images/darius-rostam.jpg'}
        width="595"
        height="842"
        loading="eager"
        decoding="async"
        alt=""
      />
      <h1>{pub.title}</h1>
      <p class="tag-row">
        {pub.openAccess && <img class="oa-icon" src="/images/open-access.svg" width="10" height="16" alt="Open access" />}
        <span class="badge badge--colored" style={chipStyle(pub.type)}>{TYPE_LABEL[pub.type]}</span>
      </p>
      <p class="meta" style="margin-top: var(--space-3);">
        {pub.venue}
        {coauthors && ` · ${coauthors}`}
      </p>

      <p class="button-row" style="margin-top: var(--space-5);">
        {pub.pdf && <a class="button" href={pub.pdf} target="_blank" rel="noopener noreferrer">PDF</a>}
        {pub.doi && <a class="button" href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer">{pub.openAccess ? 'Link' : 'Link (€)'}</a>}
        {pub.ssrn && <a class="button" href={pub.ssrn} target="_blank" rel="noopener noreferrer">SSRN</a>}
        {pub.url && <a class="button" href={pub.url} target="_blank" rel="noopener noreferrer">{pub.openAccess ? 'Link' : 'Link (€)'}</a>}
      </p>

      {
        pub.abstract && (
          <div class="abstract">
            <h2>Abstract</h2>
            <p>{pub.abstract}</p>
          </div>
        )
      }
    </div>
  </article>
</BaseLayout>

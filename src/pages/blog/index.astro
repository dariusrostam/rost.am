---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft && !data.demo)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title="Blog" description="Posts, papers I found interesting, and links worth a note — copyright, AI, law and technology.">
  <div class="page prose-width" style="padding-block: var(--space-6) var(--space-8);">
    <h1>Blog</h1>

    <ul class="card-list card-list--divided">
      {
        posts.map((post) => {
          const linkHost = post.data.link ? new URL(post.data.link).hostname.replace(/^www\./, '') : undefined;
          return (
            <li>
              <p class="meta">
                <time datetime={post.data.date.toISOString()}>{dateFormatter.format(post.data.date)}</time>
                {' · '}
                <span class="badge">{post.data.language === 'de' ? 'DE' : 'EN'}</span>
                {post.data.venue && (
                  <span class="badge badge--accent" style="margin-left: 0.3em;">
                    via {post.data.venue}
                  </span>
                )}
                {post.data.link && (
                  <span class="badge" style="margin-left: 0.3em;">
                    link{post.data.linkSource ? ` · via ${post.data.linkSource}` : linkHost ? ` · ${linkHost}` : ''}
                  </span>
                )}
              </p>
              <h2 style="margin-top: var(--space-1); font-size: var(--text-lg);">
                {post.data.link ? (
                  <a href={post.data.link} target="_blank" rel="noopener noreferrer">
                    {post.data.title} <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                )}
              </h2>
              <p>{post.data.description}</p>
              {post.data.link && (
                <p class="meta">
                  <a href={`/blog/${post.id}/`}>Permalink →</a>
                </p>
              )}
            </li>
          );
        })
      }
    </ul>

    <div style="margin-top: var(--space-8);">
      <NewsletterForm />
    </div>
  </div>
</BaseLayout>

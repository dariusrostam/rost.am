---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { SITE, SOCIALS } from '../config';

const recentPubs = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year).slice(0, 3);
const recentPosts = (await getCollection('blog', ({ data }) => !data.draft && !data.demo))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const [nowEntry] = await getCollection('now');
const { Content: NowContent } = await render(nowEntry);
const STALE_AFTER_DAYS = 45;
const daysSinceUpdate = Math.floor((Date.now() - nowEntry.data.updated.getTime()) / (1000 * 60 * 60 * 24));
const isStale = daysSinceUpdate > STALE_AFTER_DAYS;
const dateFormatter = new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

const sameAs = [SOCIALS.linkedin, SOCIALS.ssrn, SOCIALS.bluesky, SOCIALS.orcid].filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  jobTitle: 'Postdoctoral Researcher',
  affiliation: [
    { '@type': 'CollegeOrUniversity', name: 'University of Bonn' },
    { '@type': 'CollegeOrUniversity', name: 'Bucerius Law School' },
  ],
  url: SITE.url,
  sameAs,
};
---

<BaseLayout title={SITE.title} jsonLd={jsonLd}>
  <div class="page prose-width" style="padding-block: var(--space-7) var(--space-8);">
    <h1 style="font-size: var(--text-2xl);">Darius Rostam</h1>

    <p style="margin-top: var(--space-5);">
      Welcome! I am a postdoc at University of Bonn and Executive Director of the Center for Transnational IP,
      Media and Technology Law and Policy at Bucerius Law School in Hamburg.
    </p>
    <p>My research focuses on private law as well as law and technology, especially copyright and AI.</p>
    <p>You can find my publications and my blog below.</p>
    <p>
      If you'd like to collaborate, feel free to{' '}
      {SOCIALS.email ? <a href={`mailto:${SOCIALS.email}`}>email me</a> : 'email me'}. You can find me on:
    </p>

    <div class="social-icons" style="margin-top: var(--space-4);">
      <a href={SOCIALS.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={SOCIALS.ssrn} aria-label="SSRN author page" target="_blank" rel="noopener noreferrer">SSRN</a>
      <a href={SOCIALS.bluesky} aria-label="Bluesky" target="_blank" rel="me noopener noreferrer">Bluesky</a>
      <a href="/rss.xml" aria-label="RSS feed">RSS</a>
    </div>

    <h2 style="margin-top: var(--space-8);">Now</h2>
    <p class:list={['meta', { 'stale-warning': isStale }]}>
      Last updated <time datetime={nowEntry.data.updated.toISOString()}>{dateFormatter.format(nowEntry.data.updated)}</time>
      {isStale && ` — that's ${daysSinceUpdate} days ago.`}
    </p>
    <div>
      <NowContent />
    </div>
    <p><a href="/now">/now →</a></p>

    <h2 style="margin-top: var(--space-7);">Recent work</h2>
    <ul class="card-list">
      {
        recentPubs.map((pub) => (
          <li>
            <p class="meta">{pub.data.year} · {pub.data.venue}</p>
            <p>
              <a href={`/research/${pub.id}/`}>{pub.data.title}</a>
            </p>
          </li>
        ))
      }
    </ul>
    <p><a href="/research">All research →</a></p>

    <h2 style="margin-top: var(--space-7);">Recent blog</h2>
    <ul class="card-list">
      {
        recentPosts.map((post) => (
          <li>
            <p class="meta">{post.data.date.toISOString().slice(0, 10)}{post.data.venue && ` · via ${post.data.venue}`}</p>
            <p>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </p>
          </li>
        ))
      }
    </ul>
    <p><a href="/blog">All blog posts →</a></p>

    <div style="margin-top: var(--space-8);">
      <NewsletterForm />
    </div>
  </div>
</BaseLayout>

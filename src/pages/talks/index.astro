---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const talks = (await getCollection('talks')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const teaching = await getCollection('teaching');

const byYear = new Map<number, typeof talks>();
for (const talk of talks) {
  const year = talk.data.date.getFullYear();
  const list = byYear.get(year) ?? [];
  list.push(talk);
  byYear.set(year, list);
}
const years = Array.from(byYear.keys()).sort((a, b) => b - a);

const TYPE_LABEL: Record<string, string> = {
  talk: 'Talk',
  panel: 'Panel',
  lecture: 'Lecture',
  workshop: 'Workshop',
  'conference-organisation': 'Conference organisation',
};

const dateFormatter = new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title="Talks" description="Talks, panels and teaching in copyright, AI and law and technology.">
  <div class="page prose-width" style="padding-block: var(--space-6) var(--space-8);">
    <h1>Talks & Teaching</h1>

    {
      years.map((year) => (
        <div>
          <h2 class="year-heading">{year}</h2>
          <ul class="card-list">
            {byYear.get(year)!.map((talk) => (
              <li>
                <p class="meta">
                  <span class="badge badge--accent">{TYPE_LABEL[talk.data.type]}</span>
                  <span class="badge" style="margin-left: 0.3em;">{talk.data.language === 'de' ? 'DE' : 'EN'}</span>
                  {' · '}
                  <time datetime={talk.data.date.toISOString()}>{dateFormatter.format(talk.data.date)}</time>
                </p>
                <p style="margin-top: var(--space-1);">
                  <strong>{talk.data.title}</strong> — {talk.data.event}, {talk.data.institution}, {talk.data.place}
                </p>
                {talk.data.note && <p class="meta">{talk.data.note}</p>}
                <p class="meta">
                  {talk.data.slides && <a href={talk.data.slides}>Slides</a>}
                  {talk.data.slides && talk.data.link && ' · '}
                  {talk.data.link && <a href={talk.data.link}>Link</a>}
                </p>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <h2 style="margin-top: var(--space-8);">Teaching</h2>
    <ul class="card-list" style="gap: var(--space-3);">
      {
        teaching.map((course) => (
          <li>
            <p>
              <strong>{course.data.course}</strong> · {course.data.level}
            </p>
            <p class="meta">{course.data.institution} · {course.data.term}</p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

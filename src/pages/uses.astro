---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const items = await getCollection('uses');
const CATEGORY_ORDER = ['Writing & research', 'Legal research', 'Dev & automation', 'Hardware', 'Reading & notes'] as const;
---

<BaseLayout title="Uses" description="Software and tech I actually use for research, writing and legal work.">
  <div class="page prose-width" style="padding-block: var(--space-6) var(--space-8);">
    <h1>Uses</h1>
    <p>Software and hardware I actually use, grouped by what it's for.</p>

    {
      CATEGORY_ORDER.map((category) => {
        const groupItems = items.filter((i) => i.data.category === category);
        if (groupItems.length === 0) return null;
        return (
          <section style="margin-top: var(--space-6);">
            <h2 style="font-size: var(--text-lg);">{category}</h2>
            <ul class="card-list" style="gap: var(--space-3);">
              {groupItems.map((item) => (
                <li>
                  <p>
                    <strong>{item.data.url ? <a href={item.data.url}>{item.data.name}</a> : item.data.name}</strong>
                    {item.data.status && (
                      <span class="badge" style="margin-left: 0.4em;">
                        {item.data.status === 'added' ? 'Recently added' : 'Recently dropped'}
                      </span>
                    )}
                  </p>
                  <p class="meta">{item.data.reason}</p>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
  </div>
</BaseLayout>

---
import { chipColor } from '../lib/chipColors';

interface FacetOption {
  value: string;
  label: string;
  count: number;
}

interface Facet {
  key: string;
  label: string;
  options: FacetOption[];
}

interface Props {
  facets: Facet[];
  searchPlaceholder?: string;
}

const { facets, searchPlaceholder = 'Search' } = Astro.props;
---

<div class="filter-bar" data-filter-bar>
  <div class="filter-bar__search">
    <label class="visually-hidden" for="filter-search">{searchPlaceholder}</label>
    <input type="search" id="filter-search" placeholder={searchPlaceholder} data-filter-search />
  </div>
  {
    facets.map((facet) => {
      const colored = facet.key === 'type';
      return (
        <div class="filter-group">
          <span class="filter-group__label">{facet.label}</span>
          <div class="filter-group__chips">
            {facet.options.map((opt) => {
              const { light, dark } = colored ? chipColor(opt.value) : { light: '', dark: '' };
              return (
                <button
                  type="button"
                  class:list={['chip', { 'chip--colored': colored }]}
                  data-facet={facet.key}
                  data-value={opt.value}
                  aria-pressed="false"
                  style={colored ? `--chip-l: ${light}; --chip-d: ${dark};` : undefined}
                >
                  {opt.label} <span class="count" data-count>{opt.count}</span>
                </button>
              );
            })}
          </div>
        </div>
      );
    })
  }
  <button type="button" class="button" data-filter-clear>
    Clear all
  </button>
</div>

<script>
  import '../scripts/filters.js';
</script>

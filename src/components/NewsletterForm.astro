---
import { BUTTONDOWN_USERNAME } from '../config';

interface Props {
  tag?: string;
}

const { tag } = Astro.props;
const formId = `newsletter-${tag ?? 'default'}`;
---

<div class="newsletter" data-no-print>
  <p>
    <strong>Get new writing by email.</strong> A few times a year, when there's something worth sending — no growth
    hacking. See the <a href="/datenschutz">privacy note</a>.
  </p>
  <form
    class="newsletter__form"
    action={`https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_USERNAME}`}
    method="post"
    target="popupwindow"
    onsubmit={`window.open('https://buttondown.com/${BUTTONDOWN_USERNAME}', 'popupwindow')`}
    data-newsletter-form
    id={formId}
  >
    <label class="visually-hidden" for={`${formId}-email`}>Email address</label>
    <input id={`${formId}-email`} type="email" name="email" placeholder="you@example.com" required />
    {tag && <input type="hidden" name="tag" value={tag} />}
    <input class="newsletter__honeypot" type="text" name="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button class="button button--primary" type="submit">Subscribe</button>
  </form>
  <p class="newsletter__status" data-newsletter-status hidden></p>
</div>

<script>
  import '../scripts/newsletter.js';
</script>

---
import { toBibTeX, toRIS, toGermanCitation, toEnglishCitation, type Publication } from '../lib/citations';

interface Props {
  pub: Publication;
  /** Wrap in a native <details> toggle instead of always showing expanded. No JS needed. */
  collapsible?: boolean;
}

const { pub, collapsible = false } = Astro.props;

const formats = [
  { key: 'german', label: 'German legal citation', text: toGermanCitation(pub) },
  { key: 'english', label: 'English citation', text: toEnglishCitation(pub) },
  { key: 'bibtex', label: 'BibTeX', text: toBibTeX(pub) },
  { key: 'ris', label: 'RIS', text: toRIS(pub) },
];

const Wrapper = collapsible ? 'details' : 'div';
const Heading = collapsible ? 'summary' : 'h2';
---

<div class="cite-block" data-no-print>
  <Wrapper class="cite-block__toggle">
    <Heading style="font-size: var(--text-lg);">Cite this</Heading>
    <div class="cite-block__list">
      {
        formats.map((f) => (
          <div class="cite-block__item">
            <div class="cite-block__row">
              <span class="cite-block__label">{f.label}</span>
              <button type="button" class="button" data-copy={f.text}>
                Copy
              </button>
            </div>
            <pre class="cite-block__text">{f.text}</pre>
          </div>
        ))
      }
    </div>
  </Wrapper>
</div>

<script>
  import '../scripts/copy.js';
</script>

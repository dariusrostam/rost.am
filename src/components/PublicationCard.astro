---
import { TYPE_LABEL, coAuthorLine, venueWithYear, primaryLink, type Publication } from '../lib/citations';
import { chipStyle } from '../lib/chipColors';

interface Props {
  pub: Publication & { slug: string };
}

const { pub } = Astro.props;

const coauthors = coAuthorLine(pub);
const search = [pub.title, pub.venue, ...pub.authors].join(' ').toLowerCase();
const sourceHref = primaryLink(pub);
---

<li
  class="pub-row"
  data-filterable
  data-facet-area={pub.areas.join(' ')}
  data-facet-type={pub.type}
  data-search={search}
>
  <span class="pub-row__badge">
    <span class="badge badge--colored pub-row__type" style={chipStyle(pub.type)}>{TYPE_LABEL[pub.type]}</span>
  </span>
  <h3 class="pub-row__title">
    <a href={`/research/${pub.slug}/`}>{pub.title}</a>
  </h3>
  <span class="pub-row__venue">
    {pub.openAccess && <img class="oa-icon" src="/images/open-access.svg" width="10" height="16" alt="Open access" />}
    {sourceHref ? (
      <a href={sourceHref} target="_blank" rel="noopener noreferrer">{venueWithYear(pub)}</a>
    ) : (
      venueWithYear(pub)
    )}
    {coauthors && ` · ${coauthors}`}
  </span>
</li>
